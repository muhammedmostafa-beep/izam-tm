# Copy to functions/.env and fill in. Secrets (token, app secret, verify token)
# are NOT kept here; set them with `firebase functions:secrets:set` (see README).

# WhatsApp Cloud API phone number ID (WhatsApp Manager > API setup).
# Leave empty to run without WhatsApp: push notifications still work.
WHATSAPP_PHONE_NUMBER_ID=

# Graph API version used for WhatsApp calls.
WHATSAPP_API_VERSION=v23.0

# Where WhatsApp calls go. Only change it to test against a local stub.
WHATSAPP_API_BASE=https://graph.facebook.com

# Web app address, shown in WhatsApp help replies, e.g. https://<project-id>.web.app
APP_URL=
