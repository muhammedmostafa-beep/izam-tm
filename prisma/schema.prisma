// izam TM — Prisma Schema
// Complete database model for the Traceability Matrix System

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  title         String?
  avatarUrl     String?   @map("avatar_url")
  passwordHash  String?   @map("password_hash")
  googleId      String?   @unique @map("google_id")
  roleId        String?   @map("role_id") @db.Uuid
  themePref     String    @default("light") @map("theme_pref")
  viewModePref  String    @default("dashboard") @map("view_mode_pref")
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  role Role? @relation(fields: [roleId], references: [id])

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Owned entities
  ownedEpics      Epic[]         @relation("EpicOwner")
  ownedStories    UserStory[]    @relation("StoryOwner")
  requestedStories UserStory[]   @relation("StoryRequester")
  reviewedTestCases TestCase[]   @relation("TestCaseReviewer")
  reportedBugs    ProductionBug[] @relation("BugReporter")

  // Activity
  auditLogs       AuditLog[]
  comments        Comment[]
  submittedChanges ChangeRequest[] @relation("ChangeSubmitter")
  reviewedChanges  ChangeRequest[] @relation("ChangeReviewer")
  notifications    Notification[]
  notificationPrefs NotificationPreference[]
  triggeredAnalyses AiAnalysis[]

  // Config
  configuredJira   JiraConfig[]
  configuredAi     AiConfig[]
  createdReports   ScheduledReport[]

  @@map("users")
}

model AllowedDomain {
  id       String  @id @default(uuid()) @db.Uuid
  domain   String  @unique
  isActive Boolean @default(true) @map("is_active")

  @@map("allowed_domains")
}

// ═══════════════════════════════════════════
// NEXTAUTH ADAPTER TABLES
// ═══════════════════════════════════════════

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ═══════════════════════════════════════════
// CORE ENTITIES
// ═══════════════════════════════════════════

model Epic {
  id           String   @id @default(uuid()) @db.Uuid
  epicId       String   @unique @map("epic_id")
  epicTitle    String   @map("epic_title")
  ownerId      String?  @map("owner_id") @db.Uuid
  customFields Json?    @default("{}") @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner        User?         @relation("EpicOwner", fields: [ownerId], references: [id])
  userStories  UserStory[]
  linkedBugs   ProductionBug[] @relation("BugEpic")
  jiraMappings JiraProjectMapping[]

  @@map("epics")
}

model UserStory {
  id                  String    @id @default(uuid()) @db.Uuid
  storyId             String    @unique @map("story_id")
  epicId              String?   @map("epic_id") @db.Uuid
  storyTitle          String    @map("story_title")
  requesterId         String?   @map("requester_id") @db.Uuid
  reasonForRequest    String?   @map("reason_for_request") @db.Text
  businessPriority    String?   @map("business_priority")
  changeType          String?   @map("change_type")
  businessImpact      String?   @map("business_impact")
  riskLevel           String?   @map("risk_level")
  moduleFeature       String?   @map("module_feature")
  implementationSprint String?  @map("implementation_sprint")
  sprintStartDate     DateTime? @map("sprint_start_date") @db.Date
  sprintEndDate       DateTime? @map("sprint_end_date") @db.Date
  releaseVersion      String?   @map("release_version")
  deploymentDate      DateTime? @map("deployment_date") @db.Date
  storyStatus         String?   @map("story_status")
  qcStatus            String?   @map("qc_status")
  ownerId             String?   @map("owner_id") @db.Uuid
  notes               String?   @db.Text
  customFields        Json?     @default("{}") @map("custom_fields")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  epic       Epic?          @relation(fields: [epicId], references: [id])
  requester  User?          @relation("StoryRequester", fields: [requesterId], references: [id])
  owner      User?          @relation("StoryOwner", fields: [ownerId], references: [id])
  sections   StorySection[]
  testCases  TestCase[]
  linkedBugs ProductionBug[] @relation("BugStory")
  aiAnalyses AiAnalysis[]

  @@map("user_stories")
}

model StorySection {
  id             String   @id @default(uuid()) @db.Uuid
  storyId        String   @map("story_id") @db.Uuid
  sectionTitle   String   @map("section_title")
  sectionContent String?  @map("section_content") @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  story     UserStory  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@map("story_sections")
}

model TestCase {
  id                    String   @id @default(uuid()) @db.Uuid
  testCaseId            String   @unique @map("test_case_id")
  storyId               String?  @map("story_id") @db.Uuid
  storySectionId        String?  @map("story_section_id") @db.Uuid
  requirementRef        String?  @map("requirement_ref")
  testCaseTitle         String   @map("test_case_title")
  testLevel             String?  @map("test_level")
  testType              String?  @map("test_type")
  scenarioClassification String? @map("scenario_classification")
  priority              String?
  automationStatus      String?  @map("automation_status")
  reviewerId            String?  @map("reviewer_id") @db.Uuid
  testDataReference     String?  @map("test_data_reference")
  executionCycle        String?  @map("execution_cycle")
  executionStatus       String?  @map("execution_status")
  requirementCoverage   String?  @map("requirement_coverage")
  comments              String?  @db.Text
  customFields          Json?    @default("{}") @map("custom_fields")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  story        UserStory?     @relation(fields: [storyId], references: [id])
  storySection StorySection?  @relation(fields: [storySectionId], references: [id])
  reviewer     User?          @relation("TestCaseReviewer", fields: [reviewerId], references: [id])
  defectLinks  DefectLink[]
  linkedBugs   ProductionBug[] @relation("BugTestCase")

  @@map("test_cases")
}

model ProductionBug {
  id                  String    @id @default(uuid()) @db.Uuid
  bugId               String    @unique @map("bug_id")
  bugTitle            String    @map("bug_title")
  reportedDate        DateTime? @map("reported_date") @db.Date
  reportedById        String?   @map("reported_by_id") @db.Uuid
  severity            String?
  priority            String?
  environment         String?
  linkedEpicId        String?   @map("linked_epic_id") @db.Uuid
  linkedStoryId       String?   @map("linked_story_id") @db.Uuid
  releaseVersion      String?   @map("release_version")
  defectLeakagePhase  String?   @map("defect_leakage_phase")
  rootCauseCategory   String?   @map("root_cause_category")
  requirementGap      Boolean?  @default(false) @map("requirement_gap")
  testCoverageGap     Boolean?  @default(false) @map("test_coverage_gap")
  existingTestCaseId  String?   @map("existing_test_case_id") @db.Uuid
  newTestCaseNeeded   Boolean?  @default(false) @map("new_test_case_needed")
  rcaSummary          String?   @map("rca_summary") @db.Text
  preventiveAction    String?   @map("preventive_action") @db.Text
  regressionPackUpdated Boolean? @default(false) @map("regression_pack_updated")
  bugStatus           String?   @map("bug_status")
  customFields        Json?     @default("{}") @map("custom_fields")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  reportedBy       User?          @relation("BugReporter", fields: [reportedById], references: [id])
  linkedEpic       Epic?          @relation("BugEpic", fields: [linkedEpicId], references: [id])
  linkedStory      UserStory?     @relation("BugStory", fields: [linkedStoryId], references: [id])
  existingTestCase TestCase?      @relation("BugTestCase", fields: [existingTestCaseId], references: [id])
  defectLinks      DefectLink[]

  @@map("production_bugs")
}

model DefectLink {
  id         String @id @default(uuid()) @db.Uuid
  testCaseId String @map("test_case_id") @db.Uuid
  bugId      String @map("bug_id") @db.Uuid

  testCase TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  bug      ProductionBug @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, bugId])
  @@map("defect_links")
}

// ═══════════════════════════════════════════
// CONFIGURABLE SCHEMA
// ═══════════════════════════════════════════

model EntityFieldConfig {
  id               String  @id @default(uuid()) @db.Uuid
  entityType       String  @map("entity_type")
  fieldKey         String  @map("field_key")
  fieldLabel       String  @map("field_label")
  fieldType        String  @map("field_type") // text, number, date, lookup, user-select, rich-text
  lookupCategoryId String? @map("lookup_category_id") @db.Uuid
  isRequired       Boolean @default(false) @map("is_required")
  isVisible        Boolean @default(true) @map("is_visible")
  defaultValue     String? @map("default_value")
  sortOrder        Int     @default(0) @map("sort_order")
  visibilityByRole Json?   @default("{}") @map("visibility_by_role")

  lookupCategory LookupCategory? @relation(fields: [lookupCategoryId], references: [id])

  @@unique([entityType, fieldKey])
  @@map("entity_field_configs")
}

// ═══════════════════════════════════════════
// LOOKUPS
// ═══════════════════════════════════════════

model LookupCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  values       LookupValue[]
  fieldConfigs EntityFieldConfig[]

  @@map("lookup_categories")
}

model LookupValue {
  id         String  @id @default(uuid()) @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  value      String
  color      String?
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")
  isDefault  Boolean @default(false) @map("is_default")

  category         LookupCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentDependencies LookupDependency[] @relation("ParentValue")
  childDependencies  LookupDependency[] @relation("ChildValue")

  @@unique([categoryId, value])
  @@map("lookup_values")
}

model LookupDependency {
  id            String @id @default(uuid()) @db.Uuid
  parentValueId String @map("parent_value_id") @db.Uuid
  childValueId  String @map("child_value_id") @db.Uuid

  parentValue LookupValue @relation("ParentValue", fields: [parentValueId], references: [id], onDelete: Cascade)
  childValue  LookupValue @relation("ChildValue", fields: [childValueId], references: [id], onDelete: Cascade)

  @@unique([parentValueId, childValueId])
  @@map("lookup_dependencies")
}

// ═══════════════════════════════════════════
// AUDIT & COMMENTS
// ═══════════════════════════════════════════

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String   // create, update, delete
  fieldName  String?  @map("field_name")
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  content    String   @db.Text
  parentId   String?  @map("parent_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  children Comment[] @relation("CommentThread")

  @@index([entityType, entityId])
  @@map("comments")
}

// ═══════════════════════════════════════════
// APPROVALS
// ═══════════════════════════════════════════

model ChangeRequest {
  id            String    @id @default(uuid()) @db.Uuid
  submittedById String    @map("submitted_by_id") @db.Uuid
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id") @db.Uuid
  changesDiff   Json      @map("changes_diff")
  status        String    @default("pending") // pending, approved, rejected
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid
  reviewComment String?   @map("review_comment") @db.Text
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedAt    DateTime? @map("reviewed_at")

  submittedBy User  @relation("ChangeSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("ChangeReviewer", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([entityType, entityId])
  @@map("change_requests")
}

// ═══════════════════════════════════════════
// JIRA INTEGRATION
// ═══════════════════════════════════════════

model JiraConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  jiraSiteUrl         String   @map("jira_site_url")
  oauthTokenEncrypted String?  @map("oauth_token_encrypted") @db.Text
  refreshTokenEncrypted String? @map("refresh_token_encrypted") @db.Text
  configuredById      String   @map("configured_by_id") @db.Uuid
  syncIntervalMinutes Int      @default(15) @map("sync_interval_minutes")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  configuredBy    User                 @relation(fields: [configuredById], references: [id])
  projectMappings JiraProjectMapping[]
  syncLogs        JiraSyncLog[]

  @@map("jira_configs")
}

model JiraProjectMapping {
  id              String  @id @default(uuid()) @db.Uuid
  jiraConfigId    String  @map("jira_config_id") @db.Uuid
  jiraProjectKey  String  @map("jira_project_key")
  jiraProjectName String? @map("jira_project_name")
  tmEpicId        String? @map("tm_epic_id") @db.Uuid
  fieldMappings   Json?   @default("{}") @map("field_mappings")

  jiraConfig JiraConfig @relation(fields: [jiraConfigId], references: [id], onDelete: Cascade)
  tmEpic     Epic?      @relation(fields: [tmEpicId], references: [id])

  @@map("jira_project_mappings")
}

model JiraSyncLog {
  id           String    @id @default(uuid()) @db.Uuid
  jiraConfigId String    @map("jira_config_id") @db.Uuid
  projectKey   String?   @map("project_key")
  itemsCreated Int       @default(0) @map("items_created")
  itemsUpdated Int       @default(0) @map("items_updated")
  itemsSkipped Int       @default(0) @map("items_skipped")
  itemsFailed  Int       @default(0) @map("items_failed")
  errors       Json?
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  jiraConfig JiraConfig @relation(fields: [jiraConfigId], references: [id], onDelete: Cascade)

  @@map("jira_sync_logs")
}

// ═══════════════════════════════════════════
// AI ANALYSIS
// ═══════════════════════════════════════════

model AiConfig {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   // openai, anthropic
  modelName       String   @map("model_name")
  apiKeyEncrypted String   @map("api_key_encrypted") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  configuredById  String   @map("configured_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  configuredBy User         @relation(fields: [configuredById], references: [id])
  analyses     AiAnalysis[]

  @@map("ai_configs")
}

model AiAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  storyId             String   @map("story_id") @db.Uuid
  aiConfigId          String?  @map("ai_config_id") @db.Uuid
  happyCoveragePct    Float?   @map("happy_coverage_pct")
  negativeCoveragePct Float?   @map("negative_coverage_pct")
  edgeCoveragePct     Float?   @map("edge_coverage_pct")
  suggestedTestCases  Json?    @map("suggested_test_cases")
  gapsDetected        Json?    @map("gaps_detected")
  triggeredById       String?  @map("triggered_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  story       UserStory @relation(fields: [storyId], references: [id])
  aiConfig    AiConfig? @relation(fields: [aiConfigId], references: [id])
  triggeredBy User?     @relation(fields: [triggeredById], references: [id])

  @@map("ai_analyses")
}

// ═══════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  title      String
  message    String   @db.Text
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  eventType String  @map("event_type")
  inApp     Boolean @default(true) @map("in_app")
  email     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

// ═══════════════════════════════════════════
// SCHEDULED REPORTS
// ═══════════════════════════════════════════

model ScheduledReport {
  id           String    @id @default(uuid()) @db.Uuid
  reportType   String    @map("report_type")
  frequency    String    // daily, weekly, sprint-end, monthly
  filters      Json?
  recipients   Json?     // array of email addresses
  exportFormat String    @default("pdf") @map("export_format")
  createdById  String    @map("created_by_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastRun      DateTime? @map("last_run")
  nextRun      DateTime? @map("next_run")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("scheduled_reports")
}
